# Address of the deployed EvidenceManagement contract.
# Printed by `npm run deploy:local` (Hardhat) or `npm run deploy:sepolia`.
# Required - the app throws a clear error if this is missing.
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# Pinata credentials. Server-side only: these are read by the /api/ipfs/upload
# route and must NOT be prefixed with NEXT_PUBLIC_, which would ship them to the
# browser bundle where anyone can read them.
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
